# Platform Project — Environment Variables Example
# Скопируй этот файл в .env и заполни реальными значениями
# .env НИКОГДА не коммитить!

# Yandex Cloud
YC_ACCESS_KEY_ID=YCAJE...
YC_SECRET_ACCESS_KEY=YCM...
YC_BUCKET_NAME=platform-storage
YC_KMS_KEY_ID=abj...

# WebRTC
ICE_SERVERS=stun:stun.l.google.com:19302,turn:turn.example.com:3478
TURN_USERNAME=username
TURN_CREDENTIAL=password

# API Endpoints
API_BASE_URL=http://localhost:3000
WS_URL=ws://localhost:3000/ws

# Encryption
MASTER_KEY_ID=primary-key-1
KEY_ROTATION_DAYS=30

# Database (если используется)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=platform_db
DB_USER=postgres
DB_PASSWORD=password