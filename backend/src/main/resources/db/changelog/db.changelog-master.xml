<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- V1 -->
    <include file="db/changelog/v1/01-create-users-table.yaml"/>
    <include file="db/changelog/v1/02-create-posts-table.yaml"/>
    <include file="db/changelog/v1/03-create-comments-table.yaml"/>
    <include file="db/changelog/v1/04-create-reactions-table.yaml"/>
    <include file="db/changelog/v1/05-create-events-table.yaml"/>
    <include file="db/changelog/v1/06-create-messages-table.yaml"/>
    <include file="db/changelog/v1/07-create-archives-table.yaml"/>
    <include file="db/changelog/v1/08-create-indexes.yaml"/>
    <include file="db/changelog/v1/09-create-live-broadcasts-table.yaml"/>
    <include file="db/changelog/v1/10-create-notifications-table.yaml"/>

    <!-- V2 -->
    <include file="db/changelog/v2/01-add-user-roles.yaml"/>

    <!-- V3 -->
    <include file="db/changelog/v3/01-create-media-and-payments-tables.yaml"/>

    <!-- V4 -->
    <include file="db/changelog/v4/01-add-media-to-messages.yaml"/>

    <!-- V5 (ИСПРАВЛЕННЫЕ) -->
    <include file="db/changelog/v5/01-create-chat-rooms.yaml"/>
    <include file="db/changelog/v5/02-add-room-id-to-messages.yaml"/>
    <include file="db/changelog/v5/03-backfill-room-id.yaml"/>
    <include file="db/changelog/v5/04-create-room-permissions.yaml"/>

    <!-- V6 -->
    <include file="db/changelog/v6/01-default-chat-rooms-and-permissions.yaml"/>
    <include file="db/changelog/v6/01-add-performance-indexes.yaml"/>
    <include file="db/changelog/v6/05-composite-indexes.yaml"/>
    <include file="db/changelog/v6/06-add-version-columns.yaml"/>
    <include file="db/changelog/v6/07-additional-indexes.yaml"/>

    <!-- V7 -->
    <changeSet id="v7-partition-messages" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="messages_new"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/v7/01-partition-messages.sql" splitStatements="false"/>
    </changeSet>

    <!-- V8 -->
    <changeSet id="v8-archive-fields" author="platform" runInTransaction="false" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="live_broadcasts" columnName="recorded_url"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/v8/01-add-archive-fields.sql"/>
    </changeSet>

    <!-- V9: Очистка данных для первого релиза -->
    <changeSet id="v9-cleanup-data" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="users"/>
        </preConditions>
        <sqlFile path="db/changelog/v9/01-cleanup-data.sql" splitStatements="false"/>
    </changeSet>
    <include file="db/changelog/v9/02-initial-data.sql"/>

    <!-- V10: Создание таблицы access_logs (сущность AccessLog.java) -->
    <include file="db/changelog/v10/01-create-access-logs-table.yaml"/>

    <!-- V11: Создание таблицы contacts (сущность Contact.java) -->
    <include file="db/changelog/v11/01-create-contacts-table.yaml"/>

    <!-- V12: Создание таблицы event_materials (сущность EventMaterial.java) -->
    <include file="db/changelog/v12/01-create-event-materials-table.yaml"/>

    <!-- V13: Исправление таблицы notifications под JPA модель -->
    <changeSet id="v13-fix-notifications" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT 1
            </sqlCheck>
        </preConditions>
        <sqlFile path="db/changelog/v13/01-fix-notifications-schema.sql" splitStatements="false"/>
    </changeSet>

    <!-- V14: Dashboard menu items — persistent admin content storage -->
    <changeSet id="v14-create-dashboard-menu-items" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dashboard_menu_items"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/v14/01-create-dashboard-menu-items.sql" splitStatements="false"/>
    </changeSet>

    <!-- V15: Keycloak retry jobs queue -->
    <changeSet id="v15-create-keycloak-retry-jobs" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="keycloak_retry_jobs"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/v15/01-create-keycloak-retry-jobs.sql" splitStatements="false"/>
    </changeSet>

    <!-- V16: Broadcast-event linking -->
    <changeSet id="v16-add-linked-event-to-broadcasts" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="live_broadcasts" columnName="linked_event_id"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/v16/01-add-linked-event-to-broadcasts.sql" splitStatements="false"/>
    </changeSet>

    <!-- V17: Add missing @Version columns for optimistic locking -->
    <changeSet id="v17-add-missing-version-columns" author="platform" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="archives" columnName="version"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/v17/01-add-missing-version-columns.sql" splitStatements="false"/>
    </changeSet>

    <!-- V18: Fix UUID column types (VARCHAR(36) → native uuid) -->
    <include file="db/changelog/v18/01-fix-uuid-column-types.xml"/>

    <!-- Модули (ЗАКОММЕНТИРОВАНО: дублируют v3, раскомментировать только если v3 удален) -->
    <!-- <include file="db/changelog/db.changelog-media.yaml"/> -->
    <!-- <include file="db/changelog/db.changelog-payments.yaml"/> -->

</databaseChangeLog>
