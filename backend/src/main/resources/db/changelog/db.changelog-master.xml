<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="platform">
        <createTable tableName="live_broadcasts">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="stream_type" type="VARCHAR(20)"/>
            <column name="owner_id" type="VARCHAR(36)"/>
            <column name="status" type="VARCHAR(20)"/>
            <column name="viewer_count" type="INT" defaultValue="0"/>
            <column name="max_viewers" type="INT" defaultValue="0"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="ended_at" type="TIMESTAMP"/>
            <column name="hls_playlist_url" type="VARCHAR(500)"/>
            <column name="rtmp_stream_key" type="VARCHAR(100)"/>
            <column name="is_public" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_chat_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_reactions_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_recording" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="platform">
        <createTable tableName="media_files">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="owner_id" type="VARCHAR(36)"/>
            <column name="s3_key" type="VARCHAR(500)"/>
            <column name="encryption_iv" type="VARCHAR(100)"/>
            <column name="file_type" type="VARCHAR(20)"/>
            <column name="original_filename" type="VARCHAR(255)"/>
            <column name="content_type" type="VARCHAR(100)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="duration" type="INT"/>
            <column name="watermark_data" type="VARCHAR(1000)"/>
            <column name="hls_playlist_url" type="VARCHAR(500)"/>
            <column name="access_level" type="VARCHAR(20)"/>
            <column name="views_count" type="INT"/>
            <column name="download_count" type="INT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="platform">
        <createTable tableName="access_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="file_id" type="VARCHAR(36)"/>
            <column name="user_id" type="VARCHAR(36)"/>
            <column name="action" type="VARCHAR(50)"/>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="success" type="BOOLEAN"/>
            <column name="error_message" type="VARCHAR(1000)"/>
            <column name="timestamp" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="4" author="platform">
        <createIndex tableName="live_broadcasts" indexName="idx_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="live_broadcasts" indexName="idx_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="media_files" indexName="idx_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="access_logs" indexName="idx_file_id">
            <column name="file_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>