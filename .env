# Database
DB_URL=jdbc:postgresql://localhost:5432/platform
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/platform
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/platform/protocol/openid-connect/certs
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=platform
KEYCLOAK_RESOURCE=platform-backend
KEYCLOAK_SECRET=

# Media encryption
MEDIA_ENCRYPTION_KEY=change-me-in-production

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
